---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { findById, update, saveUpload, deleteUpload } from '../../../lib/db';
import { ALL_CATEGORIES, type Category, type PurseStatus } from '../../../data/purses';

export const prerender = false;

const id = Astro.params.id!;
const existing = await findById(id);
if (!existing) {
  return new Response('Not found', { status: 404 });
}

let error = '';
let success = false;
let form = {
  name: existing.name,
  description: existing.description,
  price: String(existing.price),
  category: existing.category as Category,
  status: existing.status as PurseStatus,
  images: existing.images,
};

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  form = {
    name: String(data.get('name') || '').trim(),
    description: String(data.get('description') || '').trim(),
    price: String(data.get('price') || '').trim(),
    category: (String(data.get('category') || existing.category) as Category),
    status: (String(data.get('status') || existing.status) as PurseStatus),
    images: existing.images,
  };

  const price = Number(form.price);
  if (!form.name) error = 'El nombre es obligatorio.';
  else if (!form.description) error = 'La descripción es obligatoria.';
  else if (!Number.isFinite(price) || price < 0) error = 'El precio debe ser un número válido.';
  else if (!ALL_CATEGORIES.includes(form.category)) error = 'Categoría inválida.';

  if (!error) {
    const toRemove = new Set(data.getAll('removeImage').map(String));
    const keptImages = existing.images.filter((img) => !toRemove.has(img));
    for (const img of toRemove) {
      await deleteUpload(img);
    }

    const files = data.getAll('photos') as File[];
    const newImages: string[] = [];
    for (const f of files) {
      if (f && typeof f === 'object' && 'size' in f && f.size > 0) {
        const path = await saveUpload(f, form.name);
        newImages.push(path);
      }
    }

    const finalImages = [...keptImages, ...newImages];

    const updated = await update(id, {
      name: form.name,
      description: form.description,
      price,
      category: form.category,
      status: form.status,
      images: finalImages,
    });

    if (updated) {
      form.images = updated.images;
      success = true;
    }
  }
}
---

<AdminLayout title={`Editar ${form.name} · Panel Omora`}>
  <main class="form-page">
    <h1>Editar cartera</h1>

    {success && <p class="success">✓ Cambios guardados</p>}

    <form method="post" enctype="multipart/form-data" class="form">
      {error && <p class="form__error">{error}</p>}

      <div class="form__row">
        <label for="name">Nombre</label>
        <input id="name" type="text" name="name" value={form.name} required />
      </div>

      <div class="form__row">
        <label for="description">Descripción</label>
        <textarea id="description" name="description" required>{form.description}</textarea>
      </div>

      <div class="form__row--inline">
        <div class="form__row">
          <label for="price">Precio (CLP)</label>
          <input
            id="price"
            type="number"
            name="price"
            value={form.price}
            required
            min="0"
            step="500"
            inputmode="numeric"
          />
        </div>
        <div class="form__row">
          <label for="category">Categoría</label>
          <select id="category" name="category" required>
            {
              ALL_CATEGORIES.map((c) => (
                <option value={c} selected={c === form.category}>
                  {c}
                </option>
              ))
            }
          </select>
        </div>
        <div class="form__row">
          <label for="status">Estado</label>
          <select id="status" name="status" required>
            <option value="visible" selected={form.status === 'visible'}>Visible</option>
            <option value="out-of-stock" selected={form.status === 'out-of-stock'}>Sin stock</option>
            <option value="hidden" selected={form.status === 'hidden'}>Oculta</option>
          </select>
        </div>
      </div>

      <div class="form__row">
        <span>Fotos actuales</span>
        {
          form.images.length === 0 ? (
            <p class="form__help">Sin fotos. Agrega abajo.</p>
          ) : (
            <div class="images">
              {form.images.map((img) => (
                <div class="images__item">
                  <input
                    type="checkbox"
                    name="removeImage"
                    value={img}
                    title="Marca para eliminar"
                  />
                  <img src={img} alt="" />
                  <label>Eliminar</label>
                </div>
              ))}
            </div>
          )
        }
        <p class="form__help">
          Marca las casillas de las fotos que quieras eliminar al guardar.
        </p>
      </div>

      <div class="form__row">
        <span>Agregar nuevas fotos</span>
        <label class="upload" for="photos">
          + Subir fotos
          <span class="upload__chosen" id="upload-chosen">Ninguna seleccionada</span>
          <input id="photos" type="file" name="photos" accept="image/*" multiple />
        </label>
      </div>

      <div class="form__actions">
        <a href="/admin" class="btn btn--ghost form__actions-left">← Volver</a>
        <button type="submit" class="btn btn--primary btn--lg">Guardar cambios</button>
      </div>
    </form>
  </main>

  <script>
    const input = document.getElementById('photos') as HTMLInputElement | null;
    const out = document.getElementById('upload-chosen');
    input?.addEventListener('change', () => {
      const files = input.files;
      if (!files || files.length === 0) {
        out!.textContent = 'Ninguna seleccionada';
      } else if (files.length === 1) {
        out!.textContent = files[0].name;
      } else {
        out!.textContent = `${files.length} fotos seleccionadas`;
      }
    });
  </script>
</AdminLayout>
