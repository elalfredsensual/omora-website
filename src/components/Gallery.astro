---
import { purses, categories } from '../data/purses';
import { site } from '../data/site';
import PurseCard from './PurseCard.astro';
---

<section class="section gallery" id="galeria">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <span class="kicker">Nuestra colección</span>
      <h2 class="h-section">Cada pieza, tejida a mano</h2>
      <p class="lead">
        Explora las carteras, bolsos y accesorios disponibles. ¿Te enamoraste de
        alguno? Escríbenos por WhatsApp y conversemos.
      </p>
    </div>

    <div class="filters" role="group" aria-label="Filtrar por tipo" data-reveal>
      <button class="filter is-active" data-filter="all" aria-pressed="true">
        Todas
      </button>
      {
        categories.map((cat) => (
          <button class="filter" data-filter={cat} aria-pressed="false">
            {cat}
          </button>
        ))
      }
    </div>

    <div class="gallery__grid" id="gallery-grid">
      {purses.map((purse, i) => <PurseCard purse={purse} index={i} />)}
    </div>

    <p class="gallery__empty" id="gallery-empty" hidden>
      No hay piezas en esta categoría por ahora.
    </p>
  </div>
</section>

<!-- ───── Lightbox ───── -->
<div class="lightbox" id="lightbox" aria-hidden="true">
  <div class="lightbox__backdrop" data-lb-close></div>
  <div
    class="lightbox__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lb-name"
  >
    <button class="lightbox__close" id="lb-close" data-lb-close aria-label="Cerrar">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>

    <button
      class="lightbox__nav lightbox__nav--prev"
      data-lb-prev
      aria-label="Pieza anterior"
    >
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15 6l-6 6 6 6"></path>
      </svg>
    </button>
    <button
      class="lightbox__nav lightbox__nav--next"
      data-lb-next
      aria-label="Pieza siguiente"
    >
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 6l6 6-6 6"></path>
      </svg>
    </button>

    <div class="lightbox__media-wrap">
      <div class="lightbox__media" id="lb-media"></div>
      <div class="lightbox__thumbs" id="lb-thumbs" role="tablist" aria-label="Más fotos" hidden></div>
    </div>

    <div class="lightbox__info">
      <span class="lightbox__cat" id="lb-cat"></span>
      <h3 class="lightbox__name" id="lb-name"></h3>
      <p class="lightbox__desc" id="lb-desc"></p>
      <div class="lightbox__price" id="lb-price"></div>
      <a
        class="btn btn--whatsapp btn--lg lightbox__cta"
        id="lb-wa"
        href="#"
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 32 32" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M16 3C9 3 3.5 8.5 3.5 15.5c0 2.4.7 4.7 1.9 6.7L3 29l7-1.8c1.9 1 4 1.6 6.1 1.6 7 0 12.5-5.5 12.5-12.5S23 3 16 3Zm0 22.8c-1.9 0-3.7-.5-5.3-1.5l-.4-.2-4.1 1.1 1.1-4-.3-.4a10.2 10.2 0 0 1-1.6-5.6c0-5.7 4.7-10.3 10.5-10.3 5.8 0 10.5 4.6 10.5 10.3S21.8 25.8 16 25.8Zm5.8-7.7c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-1.9-.9-3.1-1.7-4.4-3.8-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.6 0-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.9 0 1.7 1.2 3.3 1.4 3.6.2.2 2.5 3.9 6.1 5.4 2.3 1 3.2 1.1 4.3.9.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4Z"
          ></path>
        </svg>
        Me interesa esta cartera
      </a>
      <p class="lightbox__hint">
        Se abrirá WhatsApp con un mensaje listo para enviar.
      </p>
    </div>
  </div>
</div>

<style>
  .gallery {
    background: linear-gradient(180deg, var(--cream-2) 0%, var(--cream) 30%);
  }

  /* ---- filters ---- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .filter {
    padding: 0.6em 1.3em;
    font-weight: 800;
    font-size: 0.88rem;
    color: var(--cocoa);
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-pill);
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease),
      border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .filter:hover {
    border-color: var(--rose);
    color: var(--rose-deep);
    transform: translateY(-2px);
  }
  .filter.is-active {
    background: var(--rose);
    border-color: var(--rose);
    color: var(--white);
  }

  /* ---- grid ---- */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: clamp(1.1rem, 2.2vw, 1.7rem);
  }

  .gallery__empty {
    text-align: center;
    color: var(--cocoa-soft);
    font-size: 1.05rem;
    padding: 3rem 0 1rem;
  }

  /* ---- lightbox ---- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 2.5rem);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease), visibility 0.3s;
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(46, 38, 32, 0.62);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .lightbox__dialog {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    width: min(900px, 100%);
    max-height: 88svh;
    background: var(--cream);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transform: translateY(18px) scale(0.97);
    transition: transform 0.35s var(--ease);
  }
  .lightbox.is-open .lightbox__dialog {
    transform: none;
  }

  .lightbox__media-wrap {
    display: flex;
    flex-direction: column;
    background: var(--cream-2);
    min-width: 0;
    min-height: 0;
  }
  .lightbox__media {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  .lightbox__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lightbox__thumbs {
    display: flex;
    gap: 0.45rem;
    padding: 0.6rem 0.75rem;
    background: var(--cream);
    border-top: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .lightbox__thumbs button {
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.65;
    background: var(--cream-2);
    transition: opacity 0.2s var(--ease), border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .lightbox__thumbs button:hover {
    opacity: 1;
  }
  .lightbox__thumbs button.is-active {
    opacity: 1;
    border-color: var(--rose);
  }
  .lightbox__thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lightbox__ph {
    width: 100%;
    height: 100%;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    background: linear-gradient(160deg, #f3e6e2, #e7d2ce);
  }
  .lightbox__ph img {
    width: 120px;
    opacity: 0.5;
  }
  .lightbox__ph span {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--rose-deep);
  }

  .lightbox__info {
    display: flex;
    flex-direction: column;
    padding: clamp(1.6rem, 3vw, 2.6rem);
    overflow-y: auto;
  }
  .lightbox__cat {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rose-deep);
  }
  .lightbox__name {
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem);
    margin-top: 0.4rem;
  }
  .lightbox__desc {
    margin-top: 0.8rem;
    color: var(--cocoa-soft);
  }
  .lightbox__price {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: 1.1rem;
    padding-bottom: 1.3rem;
    border-bottom: 1px solid var(--line);
  }
  .lightbox__cta {
    margin-top: 1.4rem;
  }
  .lightbox__hint {
    margin-top: 0.8rem;
    font-size: 0.83rem;
    color: var(--cocoa-soft);
    text-align: center;
  }

  .lightbox__close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(251, 246, 239, 0.95);
    border: 0;
    color: var(--cocoa);
    box-shadow: var(--shadow-sm);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .lightbox__close:hover {
    background: var(--rose);
    color: #fff;
    transform: rotate(90deg);
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(251, 246, 239, 0.95);
    border: 0;
    color: var(--cocoa);
    box-shadow: var(--shadow-sm);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .lightbox__nav:hover {
    background: var(--rose);
    color: #fff;
  }
  .lightbox__nav--prev {
    left: 0.7rem;
  }
  .lightbox__nav--next {
    right: 0.7rem;
  }

  @media (max-width: 760px) {
    .lightbox__dialog {
      grid-template-columns: 1fr;
      max-height: 90svh;
      overflow-y: auto;
    }
    .lightbox__media {
      aspect-ratio: 4 / 3;
    }
    .lightbox__ph {
      min-height: 0;
    }
    .lightbox__nav {
      top: auto;
      bottom: 0.8rem;
      transform: none;
      width: 42px;
      height: 42px;
    }
    .lightbox__nav--prev {
      left: 0.8rem;
    }
    .lightbox__nav--next {
      right: 0.8rem;
    }
  }
</style>

<script define:vars={{ waNumber: site.whatsapp }}>
  const cards = [...document.querySelectorAll('[data-card]')];
  const filterBtns = [...document.querySelectorAll('[data-filter]')];
  const empty = document.getElementById('gallery-empty');

  // ---- category filter ----
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      filterBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      let shown = 0;
      cards.forEach((c) => {
        const match = f === 'all' || c.dataset.category === f;
        c.hidden = !match;
        if (match) shown++;
      });
      empty.hidden = shown > 0;
    });
  });

  // ---- lightbox ----
  const lb = document.getElementById('lightbox');
  const lbMedia = document.getElementById('lb-media');
  const lbThumbs = document.getElementById('lb-thumbs');
  const lbCat = document.getElementById('lb-cat');
  const lbName = document.getElementById('lb-name');
  const lbDesc = document.getElementById('lb-desc');
  const lbPrice = document.getElementById('lb-price');
  const lbWa = document.getElementById('lb-wa');
  let visible = [];
  let idx = 0;
  let lastFocus = null;
  let lbImages = [];
  let lbImgIdx = 0;

  const escapeHtml = (s) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

  function showImage(i) {
    if (!lbImages.length) return;
    lbImgIdx = (i + lbImages.length) % lbImages.length;
    const src = lbImages[lbImgIdx];
    const alt = lbName.textContent || '';
    lbMedia.innerHTML = `<img src="${encodeURI(src)}" alt="${escapeHtml(alt)}">`;
    lbThumbs.querySelectorAll('button').forEach((b, j) => {
      b.classList.toggle('is-active', j === lbImgIdx);
    });
  }

  function render(card) {
    const d = card.dataset;
    lbCat.textContent = d.category;
    lbName.textContent = d.name;
    lbDesc.textContent = d.desc;
    lbPrice.textContent = d.price;
    try {
      lbImages = JSON.parse(d.images || '[]').filter(Boolean);
    } catch (_) {
      lbImages = [];
    }
    if (lbImages.length) {
      if (lbImages.length > 1) {
        lbThumbs.innerHTML = lbImages
          .map(
            (src, i) =>
              `<button type="button" role="tab" aria-label="Foto ${i + 1} de ${lbImages.length}"><img src="${encodeURI(src)}" alt=""></button>`,
          )
          .join('');
        lbThumbs.hidden = false;
        lbThumbs.querySelectorAll('button').forEach((b, i) =>
          b.addEventListener('click', () => showImage(i)),
        );
      } else {
        lbThumbs.innerHTML = '';
        lbThumbs.hidden = true;
      }
      showImage(0);
    } else {
      lbMedia.innerHTML = `<div class="lightbox__ph"><img src="/images/logo-icon.png" alt=""><span>Foto próximamente</span></div>`;
      lbThumbs.innerHTML = '';
      lbThumbs.hidden = true;
    }
    const msg = `Hola Omora 🌿 Me interesa la cartera "${d.name}" (${d.price}). ¿Me puedes dar más información?`;
    lbWa.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
  }

  function show(i) {
    idx = (i + visible.length) % visible.length;
    render(visible[idx]);
  }

  function openLb(card) {
    visible = cards.filter((c) => !c.hidden);
    idx = Math.max(0, visible.indexOf(card));
    render(visible[idx]);
    lastFocus = document.activeElement;
    lb.classList.add('is-open');
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    document.getElementById('lb-close').focus();
  }

  function closeLb() {
    lb.classList.remove('is-open');
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (lastFocus) lastFocus.focus();
  }

  cards.forEach((card) => {
    card
      .querySelector('[data-card-open]')
      .addEventListener('click', () => openLb(card));
  });
  lb.querySelectorAll('[data-lb-close]').forEach((el) =>
    el.addEventListener('click', closeLb),
  );
  lb.querySelector('[data-lb-prev]').addEventListener('click', () => show(idx - 1));
  lb.querySelector('[data-lb-next]').addEventListener('click', () => show(idx + 1));

  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLb();
    else if (e.key === 'ArrowLeft') show(idx - 1);
    else if (e.key === 'ArrowRight') show(idx + 1);
    else if (e.key === 'Tab') {
      const f = [...lb.querySelectorAll('button, a[href]')];
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
