# ───────────────────────────────────────────────────────────────
#  Omora — static file server (Caddy)
#
#  This container ONLY serves the site over plain HTTP on port 80.
#  HTTPS and the omora.alfredsensual.com domain are handled by the
#  reverse proxy already running on the droplet — the same one that
#  serves managementdoral.alfredsensual.com.
# ───────────────────────────────────────────────────────────────

:80 {
	root * /srv
	encode zstd gzip
	file_server
	try_files {path} /index.html

	# Astro emits content-hashed asset names — cache them forever.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Photos you swap in — moderate cache.
	@images path /images/*
	header @images Cache-Control "public, max-age=604800"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
