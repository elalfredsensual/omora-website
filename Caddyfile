# ───────────────────────────────────────────────────────────────
#  Omora — Caddy web server
#
#  SITE_ADDRESS is supplied by docker-compose.yml:
#    • production  → omora.alfredsensual.com   (automatic HTTPS)
#    • local test  → :80                       (plain HTTP)
# ───────────────────────────────────────────────────────────────

{$SITE_ADDRESS:omora.alfredsensual.com} {
	root * /srv
	encode zstd gzip
	file_server
	try_files {path} /index.html

	# Astro emits content-hashed asset names — cache them forever.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Photos you swap in — moderate cache.
	@images path /images/*
	header @images Cache-Control "public, max-age=604800"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ───────────────────────────────────────────────────────────────
#  To ALSO put your Superset dashboard on a domain later:
#    1. Add a DNS record for the subdomain → this droplet.
#    2. Add  extra_hosts: ["host.docker.internal:host-gateway"]
#       to the `web` service in docker-compose.yml.
#    3. Uncomment and adjust the block below.
#
#  bi.alfredsensual.com {
#      reverse_proxy host.docker.internal:8091
#  }
# ───────────────────────────────────────────────────────────────
