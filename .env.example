# ─────────────────────────────────────────────────────────────
#  Omora — environment file (sample)
#
#  On the droplet, copy this file to  .env  in the same folder and
#  set strong values:
#
#    cp .env.example .env
#    nano .env
#    docker compose up -d --build
#
#  Both values are required. Without them the container refuses to
#  start. .env is gitignored — secrets stay local.
# ─────────────────────────────────────────────────────────────

# Password to log into  omora.alfredsensual.com/admin
# Pick something strong — 16+ characters, mix of letters/numbers/symbols.
ADMIN_PASSWORD=cambia-esto-por-algo-largo-y-secreto

# A random string used to sign session cookies. Treat as a secret.
# Generate one with, for example:
#   openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-32-bytes-aleatorios-hex
